# Local development (SQLite)
DATABASE_URL=sqlite:///./lr12.sqlite3
SECRET_KEY=replace-with-long-random-secret

# scripts/create_admin.py requires ADMIN_PASSWORD in the environment (not stored in repo).

# --- Docker Compose -------------------------------------------------
# Copy the block below into the same `.env` at repo root before `docker compose up`.
# Postgres image reads POSTGRES_* from the container env (via env_file in compose).
# The API reads DATABASE_URL and SECRET_KEY from the same file.
#
# POSTGRES_USER=appuser
# POSTGRES_DB=lr12_db
# POSTGRES_PASSWORD=<generate-a-long-random-value>
# DATABASE_URL=postgresql+psycopg2://appuser:<same-as-POSTGRES_PASSWORD>@db:5432/lr12_db
# SECRET_KEY=<32+ random characters>
#
# For PostgreSQL from the host machine (not Docker network), use 127.0.0.1 and your port, e.g.:
# DATABASE_URL=postgresql+psycopg2://appuser:<secret>@127.0.0.1:5432/lr12_db
